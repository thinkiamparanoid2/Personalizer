rules_version = '2';
// Paste into Firebase Console -> Firestore -> Rules (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(owner) { return signedIn() && owner == request.auth.uid; }
    // Pre-Firebase-Auth docs stored the email as owner; allowed only for a verified email
    // so the app can migrate them to the uid on first login.
    function isLegacyOwner(owner) {
      return signedIn() && request.auth.token.email_verified == true
        && owner == request.auth.token.email;
    }
    function owned() { return ['vault', 'credentials', 'movies', 'academic', 'shopping', 'chips']; }

    match /{col}/{id} {
      allow read, delete: if col in owned()
        && (isOwner(resource.data.owner) || isLegacyOwner(resource.data.owner));
      allow create: if col in owned() && isOwner(request.resource.data.owner);
      allow update: if col in owned()
        && (isOwner(resource.data.owner) || isLegacyOwner(resource.data.owner))
        && isOwner(request.resource.data.owner);
    }

    // Wrapped vault data key + PBKDF2 salt (ciphertext only).
    match /keys/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Everything else (including the old `users` collection) is denied.
  }
}
